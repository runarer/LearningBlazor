@page "/"
@inject GamesClient Client


@using static System.Net.WebRequestMethods

<PageTitle>Game Catalog</PageTitle>

<div class="mt-2">
    <a class="btn btn-primary" role="button" href="/editgame">Add New Game</a>
</div>

@if (games is null)
{
    <p><em>Loading...</em></p>
}
else if (games.Length == 0)
{
    <p><em>No games found.</em></p>
}
else
{
    <h1>Game Catalog</h1>
    <table class="table table-striped table-bordered table-hover mt-3">
        <thead class="table-dark">
            <th>Id</th>
            <th>Name</th>
            <th>Genre</th>
            <th class="text-end">Price</th>
            <th>Release Date</th>
            <th></th>
  
        </thead>
        <tbody>
            @foreach (var game in games)
            {
                <tr>
                    <td>@game.Id</td>
                    <td>@game.Name</td>
                    <td>@game.Genre</td>
                    <td class="text-end">@game.Price.ToString("C")</td>
                    <td>@game.ReleaseDate.ToString("MMMM dd, yyyy")</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    @* private GamesClient client = new(); *@
    private GameSummary[]? games;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        games = Client.GetGames();
    }
}