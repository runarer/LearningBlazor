@page "/editgame"
@inject NavigationManager NavigationManager
@inject GamesClient GamesClient
@inject GenreClient GenreClient

<PageTitle>New Game</PageTitle>
<h3>New Game</h3>

@if (genres is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="@game" FormName="editGame" OnSubmit="HandleSubmit">
                <div class="mb-3">
                    <!-- The "for" attribute of the label should match the "id" of the input-->
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" class="form-control" @bind-value="game!.Name" />
                    <label for="genre" class="form-label">Genre:</label>
                    <InputSelect id="genre" class="form-select" @bind-value="game!.GenreId">
                        <option value="">Select a genre</option>
                        @foreach (var genre in genres)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </InputSelect>
                    <label for="price" class="form-label">Price:</label>
                    <InputNumber id="price" class="form-control" @bind-value="game.Price" />
                    <label for="releaseDate" class="form-label">Release Date:</label>
                    <InputDate id="releaseDate" class="form-control" @bind-value="game.ReleaseDate" />
                </div>
                <button type="submit" class="btn btn-primary">Add Game</button>
                <a role="button" class="btn btn-secondary ms-2" href="/">Cancel</a>
            </EditForm>
        </div>
    </div>
}
@code {
    [SupplyParameterFromForm]
    private GameDetails? game { get; set; }

    @* private GenreClient genreClient = new(); *@
    @* private GamesClient gameClient = new(); *@
    private Genre[]? genres;


    protected override void OnInitialized()
    {
        genres = GenreClient.GetGenres();
        game ??= new()
        {
            Name = string.Empty,
            ReleaseDate = DateOnly.FromDateTime(DateTime.UtcNow),
        };

    }

    private void HandleSubmit()
    {
        if (game is not null)
            GamesClient.AddGame(game);
        NavigationManager.NavigateTo("/");
    }
}
